<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:models="clr-namespace:ChatGPTv3.UI.Models"
        x:Class="ChatGPTv3.UI.MainWindow"
        Title="ChatGPTv3 管理面板"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="48" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#313244" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#45475A" />
        </Style>
        <Style Selector="ListBox.nav TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="#89B4FA" />
        </Style>
        <Style Selector="ListBox.nav iconPacks|PackIconMaterialDesign">
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected iconPacks|PackIconMaterialDesign">
            <Setter Property="Foreground" Value="#89B4FA" />
        </Style>

        <Style Selector="Button#ToggleBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button#ToggleBtn:pointerover">
            <Setter Property="Background" Value="#313244" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <!-- ── Left sidebar ── -->
        <Border Grid.Column="0"
                x:Name="Sidebar"
                Background="#1E1E2E"
                Width="220">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="SineEaseInOut" />
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid Grid.Row="0"
                      x:Name="HeaderRow"
                      Background="#181825"
                      MinHeight="56">

                    <!-- Expanded layout -->
                    <StackPanel x:Name="HeaderExpanded"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0"
                                Spacing="10">
                        <iconPacks:PackIconMaterialDesign x:Name="HeaderIcon"
                                                         Width="22" Height="22"
                                                         Foreground="#89B4FA"
                                                         VerticalAlignment="Center" />
                        <TextBlock Text="ChatGPTv3"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#89B4FA"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Collapsed layout: just toggle -->
                    <Button x:Name="ToggleBtn"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="0"
                            Click="ToggleSidebar">
                        <iconPacks:PackIconMaterialDesign x:Name="ToggleIcon"
                                                         Width="20" Height="20"
                                                         Foreground="#CDD6F4"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- Nav items -->
                <ListBox Grid.Row="1"
                         x:Name="NavList"
                         Classes="nav"
                         SelectionMode="Single"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:NavigationItem"
                                      x:CompileBindings="False">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <iconPacks:PackIconMaterialDesign Kind="{Binding IconKind}"
                                                                 VerticalAlignment="Center" />
                                <TextBlock x:Name="ItemLabel"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ── Right content area ── -->
        <Border Grid.Column="1" Background="#11111B">
            <ContentControl x:Name="ContentArea"
                            Margin="16"
                            VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
