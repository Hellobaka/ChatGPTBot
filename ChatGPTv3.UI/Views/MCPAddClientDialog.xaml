<hc:Window
    x:Class="ChatGPTv3.UI.Views.MCPAddClientDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="{Binding WindowTitle}"
    Width="420"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock Margin="0,0,0,6" Text="客户端类型:" />

        <StackPanel Orientation="Horizontal">
            <RadioButton
                Content="Http (Streamable)"
                GroupName="ClientType"
                IsEnabled="{Binding CanChangeType}"
                IsChecked="{Binding IsHttp, Mode=TwoWay}" />
            <RadioButton
                Margin="16,0,0,0"
                Content="Stdio (本地进程)"
                GroupName="ClientType"
                IsEnabled="{Binding CanChangeType}"
                IsChecked="{Binding IsStdio, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,4" Text="客户端名称:" />
        <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="Endpoint URL:"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="传输模式:"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <ComboBox
            ItemsSource="{Binding TransportModes}"
            SelectedItem="{Binding TransportMode, Mode=TwoWay}"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="自定义 Header:"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <DataGrid
            Height="120"
            Margin="0,0,0,4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            ItemsSource="{Binding Headers}"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                    Header="Header 名" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    Header="值" />
                <DataGridTemplateColumn Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Width="28"
                                Height="22"
                                Padding="0"
                                Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding .}"
                                Content="✕"
                                Style="{StaticResource ButtonDefault}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button
            Command="{Binding AddHeaderCommand}"
            Content="添加 Header"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="Command:"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="Arguments:"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="环境变量:"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <DataGrid
            Height="140"
            Margin="0,0,0,4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            ItemsSource="{Binding EnvironmentVariables}"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                    Header="变量名" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    Header="值" />
                <DataGridTemplateColumn Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Width="28"
                                Height="22"
                                Padding="0"
                                Command="{Binding DataContext.RemoveEnvVarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding .}"
                                Content="✕"
                                Style="{StaticResource ButtonDefault}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button
            Command="{Binding AddEnvVarCommand}"
            Content="添加变量"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,12,0"
                Command="{Binding CancelCommand}"
                Content="取消" />
            <Button
                Width="80"
                Command="{Binding AddCommand}"
                Content="{Binding ConfirmButtonText}"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </StackPanel>
</hc:Window>
