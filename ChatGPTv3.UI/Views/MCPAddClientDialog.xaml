<hc:Window
    x:Class="ChatGPTv3.UI.Views.MCPAddClientDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="添加 MCP 客户端"
    Width="420"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock Margin="0,0,0,6" Text="客户端类型:" />

        <StackPanel Orientation="Horizontal">
            <RadioButton
                Content="Http (Streamable)"
                GroupName="ClientType"
                IsChecked="{Binding IsHttp, Mode=TwoWay}" />
            <RadioButton
                Margin="16,0,0,0"
                Content="SSE (Server-Sent Events)"
                GroupName="ClientType"
                IsChecked="{Binding IsSse, Mode=TwoWay}" />
            <RadioButton
                Margin="16,0,0,0"
                Content="Stdio (本地进程)"
                GroupName="ClientType"
                IsChecked="{Binding IsStdio, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,4" Text="客户端名称:" />
        <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="Endpoint URL:"
            Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsHttp, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="SSE Endpoint URL:"
            Visibility="{Binding IsSse, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding SseEndpoint, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsSse, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="Command:"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <TextBlock
            Margin="0,12,0,4"
            Text="Arguments:"
            Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsStdio, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,12,0"
                Command="{Binding CancelCommand}"
                Content="取消" />
            <Button
                Width="80"
                Command="{Binding AddCommand}"
                Content="添加"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </StackPanel>
</hc:Window>
