<UserControl
    x:Class="ChatGPTv3.UI.Views.ChatTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels">

    <UserControl.Resources>
        <conv:AlignmentConverter x:Key="AlignmentConv" />
        <conv:BubbleColorConverter x:Key="BubbleColorConv" />
        <conv:TextColorConverter x:Key="TextColorConv" />
        <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Toolbar ──  -->
        <Border
            Grid.Row="0"
            Padding="12,10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <ToggleButton
                    MinWidth="64"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="DarkGray"
                    Content="私聊"
                    IsChecked="{Binding IsPrivateMode}"
                    Style="{StaticResource ToggleButtonSwitch}" />
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="群:" />
                <TextBox
                    Width="180"
                    Margin="0,0,12,0"
                    VerticalContentAlignment="Center"
                    IsEnabled="{Binding IsPrivateMode, Converter={StaticResource InvertBoolToVis}}"
                    Text="{Binding GroupIdText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Text="QQ:" />
                <TextBox
                    Width="180"
                    Margin="0,0,4,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding QqText, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Width="36"
                    Height="36"
                    Margin="0,0,0,0"
                    Padding="0"
                    Command="{Binding RefreshHistoryCommand}"
                    Style="{StaticResource ButtonDefault}"
                    ToolTip="刷新历史">
                    <iconPacks:PackIconMaterialDesign
                        Width="18"
                        Height="18"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Kind="Refresh" />
                </Button>
            </WrapPanel>
        </Border>

        <TextBlock
            Grid.Row="1"
            Margin="12,8,12,0"
            Foreground="IndianRed"
            Text="{Binding ErrorMessage}" />

        <!--  ── Chat area ──  -->
        <ScrollViewer
            x:Name="ChatScroll"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="12,8" ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatBubbleItem}">
                        <StackPanel MaxWidth="480" Margin="0,4">
                            <StackPanel.HorizontalAlignment>
                                <Binding Converter="{StaticResource AlignmentConv}" Path="IsSelf" />
                            </StackPanel.HorizontalAlignment>

                            <!--  Bubble  -->
                            <Border
                                Padding="14,10"
                                Background="{Binding IsSelf, Converter={StaticResource BubbleColorConv}}"
                                CornerRadius="14">
                                <StackPanel>
                                    <Expander
                                        Margin="0,0,0,8"
                                        FontSize="11"
                                        Header="推理过程"
                                        IsExpanded="False"
                                        Opacity="0.85"
                                        Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVis}}">
                                        <Border
                                            Margin="0,6,0,0"
                                            Padding="8,6"
                                            Background="{DynamicResource RegionBrush}"
                                            CornerRadius="6">
                                            <TextBox
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="11"
                                                Foreground="{Binding IsSelf, Converter={StaticResource TextColorConv}}"
                                                IsReadOnly="True"
                                                Text="{Binding Reasoning}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                    </Expander>
                                    <TextBox
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Foreground="{Binding IsSelf, Converter={StaticResource TextColorConv}}"
                                        IsReadOnly="True"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="{Binding IsSelf, Converter={StaticResource TextColorConv}}"
                                        Opacity="0.6"
                                        Text="{Binding Time, StringFormat='MM-dd HH:mm'}" />
                                </StackPanel>
                            </Border>

                            <!--  Sender label  -->
                            <TextBlock
                                Margin="4,2,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding Sender}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  ── Input area ──  -->
        <Border
            Grid.Row="3"
            Padding="12,8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Pending images preview  -->
                <ItemsControl
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    ItemsSource="{Binding PendingImages}"
                    Visibility="{Binding HasPendingImages, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PendingImage}">
                            <Border
                                Width="56"
                                Height="56"
                                Margin="4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                    <Border
                                        Padding="3,1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="#4444"
                                        CornerRadius="0,4,0,4">
                                        <TextBlock
                                            FontSize="9"
                                            Opacity="0.85"
                                            Text="表情"
                                            Visibility="{Binding IsEmoji, Converter={StaticResource BoolToVis}}" />
                                    </Border>
                                    <Button
                                        Width="18"
                                        Height="18"
                                        Margin="1"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ButtonDefault}">
                                        <iconPacks:PackIconMaterialDesign
                                            Width="10"
                                            Height="10"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Kind="Close" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Input box + send button  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <Button
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Command="{Binding AddImageCommand}"
                            Style="{StaticResource ButtonDefault}"
                            ToolTip="添加图片">
                            <iconPacks:PackIconMaterialDesign
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Kind="Image" />
                        </Button>
                        <Button
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="0"
                            Command="{Binding AddEmojiCommand}"
                            Style="{StaticResource ButtonDefault}"
                            ToolTip="添加表情包">
                            <iconPacks:PackIconMaterialDesign
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Kind="EmojiEmotions" />
                        </Button>
                        <Button
                            Height="36"
                            MinWidth="56"
                            Padding="10,0"
                            Command="{Binding InsertAtBotCommand}"
                            Content="@Bot"
                            Style="{StaticResource ButtonDefault}"
                            ToolTip="插入 @Bot CQ 码" />
                    </StackPanel>
                    <hc:TextBox
                        x:Name="InputBox"
                        Grid.Column="1"
                        MaxHeight="100"
                        VerticalContentAlignment="Center"
                        AcceptsReturn="True"
                        FontSize="13"
                        PreviewKeyDown="OnInputKeyDown"
                        Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="2"
                        Width="78"
                        Margin="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Command="{Binding SendCommand}"
                        Content="发送"
                        Style="{StaticResource ButtonPrimary}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>