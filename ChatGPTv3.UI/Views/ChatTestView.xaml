<UserControl x:Class="ChatGPTv3.UI.Views.ChatTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels"
             xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters">

    <UserControl.Resources>
        <conv:AlignmentConverter x:Key="AlignmentConv"/>
        <conv:BubbleColorConverter x:Key="BubbleColorConv"/>
        <conv:TextColorConverter x:Key="TextColorConv"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0" Padding="12,8"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="来源群号:"
                           VerticalAlignment="Center" FontSize="13"
                           Margin="0,0,4,0"/>
                <TextBox Text="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>
                <TextBlock Text="来源QQ:"
                           VerticalAlignment="Center" FontSize="13"
                           Margin="0,0,4,0"/>
                <TextBox Text="{Binding QQ, UpdateSourceTrigger=PropertyChanged}"
                         Width="120"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#F38BA8" FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Chat area ── -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScroll">
            <ItemsControl ItemsSource="{Binding Messages}" Margin="12,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatBubbleItem}">
                        <StackPanel Margin="0,4" MaxWidth="480">
                            <StackPanel.HorizontalAlignment>
                                <Binding Path="IsSelf" Converter="{StaticResource AlignmentConv}"/>
                            </StackPanel.HorizontalAlignment>

                            <!-- Text bubble -->
                            <Border Background="{Binding IsSelf, Converter={StaticResource BubbleColorConv}}"
                                    CornerRadius="12"
                                    Padding="12,8">
                                <TextBlock Text="{Binding Content}"
                                           Foreground="{Binding IsSelf, Converter={StaticResource TextColorConv}}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Sender label -->
                            <TextBlock Text="{Binding Sender}"
                                       FontSize="11"
                                       Margin="4,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Input area ── -->
        <Border Grid.Row="2" Padding="12,8"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36" MaxHeight="100"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         KeyDown="OnInputKeyDown"/>
                <Button Grid.Column="1"
                        Content="发送"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding IsSending, Converter={StaticResource InvertBool}}"
                        FontWeight="Bold" Width="60"
                        VerticalAlignment="Stretch"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
