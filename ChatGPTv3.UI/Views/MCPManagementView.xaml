<UserControl
    x:Class="ChatGPTv3.UI.Views.MCPManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertBoolConverter x:Key="InvBool" />
        <conv:InvertBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Shared TreeView  -->
        <TreeView
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,12,0"
            ItemsSource="{Binding ServerNodes}"
            SelectedItemChanged="SharedTree_SelectedItemChanged"
            Style="{StaticResource TreeView.Small}">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:MCPServerNode}" ItemsSource="{Binding Tools}">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Padding="3,1"
                            VerticalAlignment="Center"
                            CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBuiltInGroup}" Value="True">
                                            <Setter Property="Background" Value="#2A5A3A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBuiltInGroup}" Value="False">
                                            <Setter Property="Background" Value="#3A4A6A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="11"
                                Foreground="#CDE0F4"
                                Text="{Binding TypeBadge}" />
                        </Border>
                        <TextBlock
                            Margin="6,0,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding Name}" />
                        <Border
                            Margin="6,0,0,0"
                            Padding="3,1"
                            VerticalAlignment="Center"
                            Background="{Binding ConnectionBadgeColor}"
                            CornerRadius="3"
                            Visibility="{Binding HasConnectionBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="10"
                                Foreground="#CDE0F4"
                                Text="{Binding ConnectionBadgeText}" />
                        </Border>
                        <TextBlock
                            Margin="6,0,0,0"
                            FontSize="11"
                            Opacity="0.5"
                            Text="{Binding Status}" />
                    </StackPanel>
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MCPToolLeaf}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TabControl
            Grid.Row="0"
            Grid.Column="1"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
            Style="{StaticResource TabControlInLine}">

            <!--  ═══ Tab 1: 服务端管理 ═══  -->
            <TabItem Header="服务端管理">
                <Border
                    Margin="0,8,0,0"
                    Padding="24"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasExternalServerSelected, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                IsReadOnly="True"
                                                Text="{Binding SelectedClientName, Mode=OneWay}" />
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="3,1"
                                                VerticalAlignment="Center"
                                                Background="{Binding SelectedServer.ConnectionBadgeColor}"
                                                CornerRadius="3"
                                                Visibility="{Binding HasExternalServerSelected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="#CDE0F4"
                                                    Text="{Binding SelectedServer.ConnectionBadgeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBox
                                            Margin="0,2,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsReadOnly="True"
                                            Opacity="0.56"
                                            Text="{Binding SelectedClientType, StringFormat='类型: {0}', Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0" Command="{Binding ToggleEnabledCommand}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource ButtonPrimary}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedClientEnabled}" Value="True">
                                                            <Setter Property="Content" Value="禁用" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelectedClientEnabled}" Value="False">
                                                            <Setter Property="Content" Value="启用" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ToggleButton
                                            Width="80"
                                            Margin="0,0,8,0"
                                            Content="重连"
                                            IsChecked="{Binding IsReconnecting, Mode=TwoWay}"
                                            IsEnabled="{Binding IsReconnecting, Converter={StaticResource InvBool}, FallbackValue=True}"
                                            Style="{StaticResource ToggleButtonLoadingPrimary}" />
                                        <ToggleButton
                                            Margin="0,0,8,0"
                                            Content="刷新工具"
                                            IsChecked="{Binding IsRefreshingExternalTools, Mode=TwoWay}"
                                            IsEnabled="{Binding IsRefreshingExternalTools, Converter={StaticResource InvBool}, FallbackValue=True}"
                                            Style="{StaticResource ToggleButtonLoadingPrimary}" />
                                        <Button Command="{Binding DeleteServerCommand}" Content="删除" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasToolSelected, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBox
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    IsReadOnly="True"
                                    Style="{StaticResource TextBox.Small}"
                                    Text="{Binding SelectedTool.Name, Mode=OneWay}" />
                                <TextBox
                                    Margin="0,2,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    Opacity="0.56"
                                    Style="{StaticResource TextBox.Small}"
                                    Text="{Binding SelectedTool.ServerName, StringFormat='来源: {0}', Mode=OneWay}" />
                                <TextBox
                                    Margin="0,10,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    Opacity="0.72"
                                    Style="{StaticResource TextBox.Small}"
                                    Text="{Binding SelectedTool.Description, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <Border
                                    Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="工具别名" />
                                            <TextBox Grid.Column="1" Text="{Binding ToolAlias, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>

                                        <TextBlock
                                            Margin="0,14,0,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="权限设置" />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="启用群聊" />
                                            <CheckBox
                                                Grid.Column="1"
                                                IsChecked="{Binding GroupEnabled, Mode=TwoWay}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="群号列表" />
                                            <TextBox Grid.Column="1" Text="{Binding GroupsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="群组黑名单模式" />
                                            <CheckBox
                                                Grid.Column="1"
                                                IsChecked="{Binding IsGroupBlackList, Mode=TwoWay}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                        </Grid>

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="启用私聊" />
                                            <CheckBox
                                                Grid.Column="1"
                                                IsChecked="{Binding PersonEnabled, Mode=TwoWay}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="QQ号列表" />
                                            <TextBox Grid.Column="1" Text="{Binding PersonsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="私聊黑名单模式" />
                                            <CheckBox
                                                Grid.Column="1"
                                                IsChecked="{Binding IsPersonBlackList, Mode=TwoWay}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="仅限管理调用" />
                                            <CheckBox
                                                Grid.Column="1"
                                                IsChecked="{Binding CanOnlyMasterCall, Mode=TwoWay}"
                                                Style="{StaticResource ToggleButtonSwitch}" />
                                        </Grid>

                                        <Button
                                            Margin="0,14,0,0"
                                            Command="{Binding SavePermissionsCommand}"
                                            Content="保存权限配置"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Opacity="0.4"
                            Text="在左侧选择一个服务端或工具"
                            Visibility="{Binding HasClientSelected, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </Border>
            </TabItem>

            <!--  ═══ Tab 2: 工具测试 ═══  -->
            <TabItem Header="工具测试">
                <Border
                    Margin="0,8,0,0"
                    Padding="24"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel Visibility="{Binding HasToolSelected, Converter={StaticResource BoolToVis}}">
                                <TextBox
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    IsReadOnly="True"
                                    Text="{Binding SelectedTool.Name, Mode=OneWay}" />
                                <TextBox
                                    Margin="0,2,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Opacity="0.5"
                                    Text="{Binding SelectedTool.ServerName, StringFormat='来源: {0}', Mode=OneWay}" />
                                <TextBox
                                    Margin="0,12,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    Opacity="0.72"
                                    Text="{Binding SelectedTool.Description, Mode=OneWay}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,14,0,4"
                                    FontWeight="SemiBold"
                                    Text="测试上下文" />
                                <WrapPanel>
                                    <TextBlock VerticalAlignment="Center" Text="群号" />
                                    <TextBox
                                        Width="120"
                                        Margin="6,0,14,0"
                                        Text="{Binding TestGroupId, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock VerticalAlignment="Center" Text="QQ" />
                                    <TextBox
                                        Width="120"
                                        Margin="6,0,14,0"
                                        Text="{Binding TestQQ, UpdateSourceTrigger=LostFocus}" />
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        Content="群聊"
                                        IsChecked="{Binding TestIsGroupChat, Mode=TwoWay}" />
                                </WrapPanel>

                                <TextBlock
                                    Margin="0,14,0,4"
                                    FontWeight="SemiBold"
                                    Text="参数 (JSON)" />
                                <TextBox
                                    Height="120"
                                    Padding="8"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Text="{Binding TestJsonArgs, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />

                                <ToggleButton
                                    Width="100"
                                    Height="32"
                                    Margin="0,10,0,0"
                                    Content="执行"
                                    IsChecked="{Binding IsTestBusy, Mode=TwoWay}"
                                    IsEnabled="{Binding IsTestBusy, Converter={StaticResource InvBool}, FallbackValue=True}"
                                    Style="{StaticResource ToggleButtonLoadingPrimary}" />

                                <TextBlock
                                    Margin="0,14,0,4"
                                    FontWeight="SemiBold"
                                    Text="结果" />
                                <TextBox
                                    MinHeight="120"
                                    Padding="8"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Text="{Binding TestResult}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Opacity="0.4"
                                Text="在左侧选择一个工具查看详情"
                                Visibility="{Binding HasToolSelected, Converter={StaticResource InvBoolToVis}}" />
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!--  Bottom bar  -->
        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="10,8"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding OpenAddClientDialogCommand}"
                    Content="添加服务端" />
                <Button Command="{Binding RebuildAllCommand}" Content="重建全部连接" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
