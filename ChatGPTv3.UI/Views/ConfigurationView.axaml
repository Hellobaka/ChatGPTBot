<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels"
             x:Class="ChatGPTv3.UI.Views.ConfigurationView"
             x:DataType="vm:ConfigurationViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ── TabControl fills available space ── -->
        <TabControl Grid.Row="1"
                    x:Name="ConfigTabs"
                    ItemsSource="{Binding Tabs}"
                    TabStripPlacement="Top">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigTab"
                              x:CompileBindings="False">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14" FontWeight="Medium"
                               Padding="8,4" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ConfigTab"
                              x:CompileBindings="False">
                    <ScrollViewer>
                        <StackPanel Spacing="12" Margin="8">
                            <ItemsControl ItemsSource="{Binding Sections}"
                                          x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfigSection"
                                                  x:CompileBindings="False">
                                        <Border Background="#1E1E2E"
                                                CornerRadius="6"
                                                Padding="14,10"
                                                Margin="0,0,0,4">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="#89B4FA"
                                                           Margin="0,0,0,4" />
                                                <ItemsControl x:Name="EntryList"
                                                              ItemsSource="{Binding Items}"
                                                              x:CompileBindings="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ConfigEntry"
                                                                      x:CompileBindings="False">
                                                            <ContentControl x:Name="RowHost"
                                                                            Loaded="OnConfigRowLoaded" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- ── Fixed bottom bar ── -->
        <Border Grid.Row="2"
                Background="#181825"
                Padding="16,10"
                BorderThickness="0,1,0,0"
                BorderBrush="#313244">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存"
                        Command="{Binding SaveAllCommand}"
                        Background="#89B4FA" Foreground="#11111B"
                        FontWeight="Bold" Padding="28,8"
                        FontSize="14" />
                <Button Content="重置为默认值"
                        Command="{Binding ResetAllCommand}"
                        Background="#45475A" Foreground="#CDD6F4"
                        Padding="20,8" FontSize="13" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
