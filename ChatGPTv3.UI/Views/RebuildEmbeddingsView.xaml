<hc:Window
    x:Class="ChatGPTv3.UI.Views.RebuildEmbeddingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="重建图片向量索引"
    Width="480"
    Height="320"
    Closing="OnClosing"
    ResizeMode="NoResize"
    Style="{StaticResource WindowWin10}"
    WindowStartupLocation="CenterOwner">

    <hc:Window.Resources>
        <conv:InvertBoolConverter x:Key="InvBool" />
        <conv:InvertBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </hc:Window.Resources>

    <Border
        Padding="20"
        Background="{DynamicResource PopupBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Title  -->
            <TextBlock
                Grid.Row="0"
                FontSize="16"
                FontWeight="Bold"
                Text="重建图片向量索引" />

            <TextBlock
                Grid.Row="1"
                Margin="0,6,0,0"
                FontSize="12"
                Opacity="0.7"
                Text="为所有已描述的表情图片重新计算并写入 Qdrant 向量索引。"
                TextWrapping="Wrap" />

            <!--  Progress bar  -->
            <ProgressBar
                Grid.Row="2"
                Margin="0,16,0,0"
                Maximum="1"
                Minimum="0"
                Value="{Binding Progress, Mode=OneWay}" />

            <!--  Status + buttons  -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock
                    FontSize="12"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="11"
                    Opacity="0.6">
                    <Run Foreground="#4CAF50" Text="成功：" />
                    <Run Text="{Binding SuccessCount}" />
                    <Run Foreground="#F44336" Text="  失败：" />
                    <Run Text="{Binding FailCount}" />
                    <Run Text="  总计：" />
                    <Run Text="{Binding Total}" />
                </TextBlock>

                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        IsEnabled="{Binding IsRunning}"
                        Style="{StaticResource ButtonDefault}" />
                    <ToggleButton
                        Width="80"
                        Margin="10,0,0,0"
                        Command="{Binding StartCommand}"
                        Content="开始"
                        IsChecked="{Binding IsRunning, Mode=TwoWay}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}, FallbackValue=True}"
                        Style="{StaticResource ToggleButtonLoadingPrimary}" />
                    <Button
                        Width="80"
                        Margin="10,0,0,0"
                        Click="OnCloseClick"
                        Content="关闭"
                        Style="{StaticResource ButtonDefault}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</hc:Window>
