<hc:Window
    x:Class="ChatGPTv3.UI.Views.BatchAddImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels"
    Title="批量导入图片"
    Width="720"
    Height="660"
    WindowStartupLocation="CenterOwner">

    <hc:Window.Resources>
        <conv:ImportStatusColorConverter x:Key="StatusColor" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertBoolConverter x:Key="InvBool" />
        <conv:InvertBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </hc:Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top: summary bar  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12"
            Background="{DynamicResource Region1}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding TotalCount}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="总计" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#4CAF50"
                        Text="{Binding ImportedCount}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="已导入" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#FF9800"
                        Text="{Binding SkippedCount}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="已跳过" />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#F44336"
                        Text="{Binding FailedCount}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="失败" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Settings bar  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="12,8"
            Background="{DynamicResource Region1}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Concurrency slider  -->
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="并发数量：" />
                <Grid Grid.Column="1" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Background="{StaticResource BorderBrush}"
                        Maximum="30"
                        Minimum="1"
                        Value="{Binding Concurrency}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{Binding Concurrency, StringFormat={}{0}}"
                        TextAlignment="Center" />
                </Grid>

                <!--  IsEmoji toggle  -->
                <TextBlock
                    Grid.Column="2"
                    Margin="16,0,8,0"
                    VerticalAlignment="Center"
                    Text="默认作为表情包：" />
                <CheckBox
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsChecked="{Binding DefaultIsEmoji}"
                    Style="{StaticResource ToggleButtonSwitch}" />
            </Grid>
        </Border>

        <!--  Status message  -->
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            FontSize="12"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="{Binding StatusMessage}" />

        <!--  Image list  -->
        <DataGrid
            Grid.Row="3"
            Margin="0,0,0,12"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            IsReadOnly="False"
            ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FileName}"
                    Header="文件名" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding Md5}"
                    Header="MD5" />
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding IsEmoji}"
                    Header="表情包" />
                <DataGridTemplateColumn Width="80" Header="状态">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{Binding Status, Converter={StaticResource StatusColor}}"
                                Text="{Binding Status}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*" Header="详情">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTip="{Binding StatusMessage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  Progress bar  -->
        <ProgressBar
            Grid.Row="4"
            Margin="0,0,0,12"
            Maximum="{Binding TotalCount}"
            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
            Value="{Binding ImportedCount}" />

        <!--  Bottom buttons  -->
        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,12,0"
                Click="SelectFiles_Click"
                Content="选择文件"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource InvBool}}" />
            <ToggleButton
                Width="110"
                Margin="0,0,12,0"
                Command="{Binding ImportCommand}"
                Content="开始导入"
                IsChecked="{Binding IsProcessing, Mode=TwoWay}"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource InvBool}, FallbackValue=True}"
                Style="{StaticResource ToggleButtonLoadingPrimary}" />
            <Button
                Width="90"
                Click="Cancel_Click"
                Content="关闭"
                IsEnabled="{Binding IsProcessing, Converter={StaticResource InvBool}}" />
        </StackPanel>
    </Grid>
</hc:Window>
