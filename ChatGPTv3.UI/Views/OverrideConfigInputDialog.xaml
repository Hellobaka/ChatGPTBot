<hc:Window
    x:Class="ChatGPTv3.UI.Views.OverrideConfigInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="添加配置"
    Width="320"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" Text="配置类型:" Margin="0,0,10,0" />
            <ComboBox
                x:Name="TypeComboBox"
                Width="80"
                SelectionChanged="TypeComboBox_SelectionChanged">
                <ComboBoxItem Content="群聊" IsSelected="True" />
                <ComboBoxItem Content="私聊" />
            </ComboBox>
        </StackPanel>

        <TextBlock Margin="0,0,0,8" Text="输入目标 ID:" />
        <hc:TextBox
            x:Name="TargetIdBox"
            hc:InfoElement.Placeholder="ID"
            Style="{StaticResource TextBoxExtend}"
            TextAlignment="Left" />

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,12,0"
                Click="Cancel_Click"
                Content="取消" />
            <Button
                Width="80"
                Click="Confirm_Click"
                Content="确定"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </StackPanel>
</hc:Window>
