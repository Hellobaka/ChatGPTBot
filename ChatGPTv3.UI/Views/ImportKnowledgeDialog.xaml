<hc:Window
    x:Class="ChatGPTv3.UI.Views.ImportKnowledgeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels"
    Title="导入知识库"
    Width="560"
    Height="520"
    ResizeMode="NoResize"
    Style="{StaticResource WindowWin10}"
    WindowStartupLocation="CenterOwner">

    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </hc:Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="SemiBold"
            Text="导入知识到知识库" />

        <!-- Source title input -->
        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Width="60"
                VerticalAlignment="Center"
                Text="来源标题：" />
            <hc:TextBox
                Grid.Column="1"
                Text="{Binding SourceTitle, UpdateSourceTrigger=PropertyChanged}"
                hc:InfoElement.Placeholder="必填，如：用户手册V1.0"
                hc:InfoElement.TitleWidth="60"
                IsEnabled="{Binding CanEdit}" />
        </Grid>

        <!-- Text content -->
        <hc:TextBox
            Grid.Row="2"
            Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,8,0,12"
            AcceptsReturn="True"
            hc:InfoElement.Placeholder="在此粘贴文本内容，或点击「选择文件」按钮导入文件"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            IsEnabled="{Binding CanEdit}" />

        <!-- Progress -->
        <StackPanel
            Grid.Row="3"
            Margin="0,0,0,8"
            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
            <ProgressBar
                Height="20"
                Maximum="{Binding ImportTotal}"
                Value="{Binding ImportCurrent}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12"
                Text="{Binding ImportStatus}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding BrowseFileCommand}"
                Content="选择文件"
                IsEnabled="{Binding CanEdit}" />
            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding ImportCommand}"
                Content="确定"
                IsEnabled="{Binding CanEdit}"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="取消"
                IsEnabled="{Binding CanEdit}" />
        </StackPanel>
    </Grid>
</hc:Window>
