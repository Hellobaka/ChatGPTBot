<UserControl
    x:Class="ChatGPTv3.UI.Views.KnowledgeManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels">
    <UserControl.Resources>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <converters:InvertBoolConverter x:Key="InvBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top toolbar  -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <hc:TextBox
                Grid.Column="0"
                hc:InfoElement.Placeholder="搜索知识内容..."
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Column="1"
                Width="70"
                Margin="8,0,0,0"
                Command="{Binding SearchCommand}"
                Content="搜索"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />

            <Button
                Grid.Column="2"
                Width="70"
                Margin="8,0,0,0"
                Command="{Binding RefreshCommand}"
                Content="刷新"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />

            <Button
                Grid.Column="3"
                Width="70"
                Margin="8,0,0,0"
                Command="{Binding ImportCommand}"
                Content="导入"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}"
                Style="{StaticResource ButtonPrimary}" />
        </Grid>

        <!--  Left: Source TreeView  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,12,0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="8,8,8,4"
                    FontWeight="SemiBold"
                    Text="知识库" />

                <TreeView
                    Grid.Row="1"
                    Margin="4,0,4,8"
                    ItemsSource="{Binding Sources}"
                    SelectedItemChanged="TreeView_OnSelectedItemChanged"
                    Style="{StaticResource TreeView.Small}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                            <!--  Group level  -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding Count, StringFormat='({0})'}" />
                            </StackPanel>
                            <!--  Item level  -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Width="200"
                                        VerticalAlignment="Center"
                                        Text="{Binding DisplayText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource TreeViewItemBaseStyle}" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                            <EventSetter Event="MouseRightButtonUp" Handler="TreeViewItem_RightClick" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <!--  Right: Detail panel  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  No selection hint  -->
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="请选择一条知识查看详情"
                    Visibility="{Binding SelectedItem, Converter={StaticResource Object2VisibilityReConverter}, ConverterParameter=Invert}" />

                <!--  Detail content  -->
                <StackPanel Grid.Row="0" Visibility="{Binding SelectedItem, Converter={StaticResource NotNullToVis}}">
                    <TextBlock FontWeight="SemiBold" Text="来源" />
                    <TextBlock
                        Margin="0,4,0,8"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding SelectedItem.Source}" />

                    <TextBlock FontWeight="SemiBold" Text="创建时间" />
                    <TextBlock
                        Margin="0,4,0,8"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding SelectedItem.CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" />

                    <TextBlock FontWeight="SemiBold" Text="内容" />
                </StackPanel>

                <!--  Edit mode  -->
                <TextBox
                    Grid.Row="3"
                    Margin="0,8,0,8"
                    AcceptsReturn="True"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    IsReadOnly="{Binding IsEditing, Converter={StaticResource InvBool}}"
                    Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedItem, Converter={StaticResource NotNullToVis}}" />

                <!--  Action buttons  -->
                <StackPanel
                    Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding SelectedItem, Converter={StaticResource NotNullToVis}}">
                    <!--  Edit button  -->
                    <Button
                        Width="70"
                        Command="{Binding StartEditCommand}"
                        Content="编辑"
                        IsEnabled="{Binding IsEditing, Converter={StaticResource InvBool}}" />

                    <!--  Save button  -->
                    <Button
                        Width="70"
                        Margin="8,0,0,0"
                        Command="{Binding SaveEditCommand}"
                        Content="保存"
                        IsEnabled="{Binding IsEditing}"
                        Style="{StaticResource ButtonPrimary}" />

                    <!--  Cancel button  -->
                    <Button
                        Width="70"
                        Margin="8,0,0,0"
                        Command="{Binding CancelEditCommand}"
                        Content="取消"
                        IsEnabled="{Binding IsEditing}" />

                    <!--  Delete button  -->
                    <Button
                        Width="70"
                        Margin="8,0,0,0"
                        Background="{DynamicResource DangerBrush}"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        Content="删除"
                        IsEnabled="{Binding IsEditing, Converter={StaticResource InvBool}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Loading overlay  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#60000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border
                Width="260"
                Height="140"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Margin="16">
                    <ProgressBar
                        Height="20"
                        Margin="0,0,0,12"
                        IsIndeterminate="True" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Text="加载中..." />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding LoadingStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
