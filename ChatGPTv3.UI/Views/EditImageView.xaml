<hc:Window
    x:Class="ChatGPTv3.UI.Views.EditImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels"
    Title="编辑图片描述"
    Width="560"
    Height="480"
    WindowStartupLocation="CenterOwner">

    <hc:Window.Resources>
        <conv:InvertBoolConverter x:Key="InvBool" />
        <conv:InvertBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </hc:Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="18"
            FontWeight="SemiBold"
            Text="编辑图片描述" />

        <!--  Description  -->
        <hc:TextBox
            Grid.Row="1"
            MinHeight="100"
            Margin="0,0,0,12"
            hc:InfoElement.Title="描述"
            hc:InfoElement.TitleWidth="80"
            AcceptsReturn="True"
            Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <!--  Separator  -->
        <Separator Grid.Row="2" Margin="0,8" />

        <!--  Re-describe section  -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,12"
            Padding="12"
            Background="{DynamicResource Region1}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="AI 重新描述" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <hc:TextBox
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        hc:InfoElement.Placeholder="额外提示（可选），如：重点描述表情"
                        Text="{Binding ExtraPrompt, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleButton
                        Grid.Column="1"
                        MinWidth="100"
                        Command="{Binding RedescribeCommand}"
                        Content="重新描述"
                        IsChecked="{Binding IsRedescribing, Mode=TwoWay}"
                        IsEnabled="{Binding IsRedescribing, Converter={StaticResource InvBool}, FallbackValue=True}"
                        Style="{StaticResource ToggleButtonLoadingPrimary}" />
                </Grid>
            </Grid>
        </Border>

        <!--  Error message  -->
        <TextBlock
            Grid.Row="4"
            Margin="0,0,0,12"
            FontSize="12"
            Foreground="{StaticResource DangerBrush}"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />

        <!--  Bottom buttons  -->
        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ToggleButton
                Width="90"
                Margin="0,0,12,0"
                Command="{Binding SaveCommand}"
                Content="保存"
                IsChecked="{Binding IsSaving, Mode=TwoWay}"
                IsEnabled="{Binding IsSaving, Converter={StaticResource InvBool}, FallbackValue=True}"
                Style="{StaticResource ToggleButtonLoadingPrimary}" />
            <Button
                Width="90"
                Command="{Binding CancelCommand}"
                Content="取消"
                Style="{StaticResource ButtonDefault}" />
        </StackPanel>
    </Grid>
</hc:Window>
