<UserControl x:Class="ChatGPTv3.UI.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels"
             xmlns:hc="https://handyorg.github.io/handycontrol">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── TabControl ── -->
        <TabControl x:Name="ConfigTabs"
                    Grid.Row="0"
                    ItemsSource="{Binding Tabs}"
                    TabStripPlacement="Top"
                    BorderThickness="0"
                    Background="Transparent">

            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ConfigTab}">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Padding="12,6"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:ConfigTab}">
                    <ScrollViewer>
                        <StackPanel Margin="4,8,16,8">
                            <ItemsControl ItemsSource="{Binding Sections}"
                                          Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConfigSection}">
                                        <Border Margin="0,0,0,16"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <!-- Section header -->
                                                <Border Padding="14,10"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <!-- Section items -->
                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              Margin="14,8"
                                                              Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ConfigEntry}">
                                                            <ContentControl Loaded="OnConfigRowLoaded"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- ── Bottom bar ── -->
        <Border Grid.Row="1"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="保存"
                        Command="{Binding SaveAllCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        MinWidth="100"
                        Margin="0,0,12,0"/>
                <Button Content="重置为默认值"
                        Command="{Binding ResetAllCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
