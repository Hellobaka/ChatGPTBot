<UserControl
    x:Class="ChatGPTv3.UI.Views.KeyManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <!-- ═══ Tab 1: 服务商列表 ═══ -->
            <TabItem Header="服务商列表">
                <Grid Margin="4,8,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding AddProviderCommand}"
                            Content="新增服务商"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ReloadCommand}"
                            Content="刷新" />
                        <Button
                            Command="{Binding RemoveProviderCommand}"
                            CommandParameter="{Binding SelectedProvider}"
                            Content="删除选中" />
                    </WrapPanel>

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Providers}"
                        SelectedItem="{Binding SelectedProvider}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding Name}"
                                Header="名称" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding EndPoint}"
                                Header="端点" />
                            <DataGridCheckBoxColumn
                                Width="80"
                                Binding="{Binding UseTencentSign}"
                                Header="腾讯云签名" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding TotalTokens, StringFormat=N0}"
                                Header="累计 Token" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding TotalConsume, StringFormat=F4}"
                                Header="累计花费" />
                            <DataGridTemplateColumn Width="70" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Padding="8,2"
                                            Command="{Binding DataContext.EditProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="编辑"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══ Tab 2: 用途绑定 ═══ -->
            <TabItem Header="用途绑定">
                <ScrollViewer Margin="4,8,4,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PurposeGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PurposeBindingGroup}">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14,12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Opacity="0.68"
                                                    Text="{Binding Description}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Command="{Binding DataContext.AddPurposeBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="+ 绑定"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="12"
                                                Opacity="0.6"
                                                Text="服务商" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="12"
                                                Opacity="0.6"
                                                Text="模型" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PurposeBindingItem}">
                                                    <Border
                                                        Margin="0,0,0,6"
                                                        Padding="8,6"
                                                        Background="{DynamicResource RegionBrush}"
                                                        CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox
                                                                Grid.Column="0"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding DataContext.Providers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                SelectedItem="{Binding SelectedProvider, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ComboBox
                                                                Grid.Column="2"
                                                                DisplayMemberPath="Name"
                                                                ItemsSource="{Binding AvailableModels}"
                                                                SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button
                                                                Grid.Column="3"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.RemovePurposeBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="删除" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="13"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Opacity="0.55"
                                            Text="暂无绑定 — 点击「+ 绑定」添加">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border
            Grid.Row="1"
            Padding="16,10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Button
                MinWidth="120"
                Command="{Binding SaveAllCommand}"
                Content="保存全部"
                Style="{StaticResource ButtonPrimary}" />
        </Border>
    </Grid>
</UserControl>