<UserControl
    x:Class="ChatGPTv3.UI.Views.KeyManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="clr-namespace:ChatGPTv3.UI.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding AddProviderCommand}"
                        Content="新增服务商"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding ReloadCommand}"
                        Content="刷新" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="IndianRed"
                        Text="{Binding ErrorMessage}" />
                </WrapPanel>

                <Expander
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Header="服务商管理"
                    IsExpanded="True">
                    <StackPanel Margin="0,10,0,0">
                        <!--  Provider selector + actions  -->
                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="当前服务商：" />
                            <ComboBox
                                Width="300"
                                Margin="10,0,12,0"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Providers}"
                                SelectedItem="{Binding SelectedProvider}" />
                            <Button
                                Margin="0,0,0,0"
                                Command="{Binding RemoveProviderCommand}"
                                CommandParameter="{Binding SelectedProvider}"
                                Content="删除" />
                        </WrapPanel>

                        <!--  Provider edit fields  -->
                        <Border
                            Padding="12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Width="340" Margin="0,0,12,10">
                                        <TextBlock FontWeight="SemiBold" Text="名称" />
                                        <TextBox Margin="0,6,0,0" Text="{Binding SelectedProvider.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="340" Margin="0,0,12,10">
                                        <TextBlock FontWeight="SemiBold" Text="EndPoint" />
                                        <TextBox Margin="0,6,0,0" Text="{Binding SelectedProvider.EndPoint, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="340" Margin="0,0,12,10">
                                        <TextBlock FontWeight="SemiBold" Text="API Key" />
                                        <TextBox Margin="0,6,0,0" Text="{Binding SelectedProvider.Key, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>

                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                    <CheckBox
                                        Margin="0,0,20,0"
                                        VerticalAlignment="Center"
                                        Content="腾讯云签名"
                                        IsChecked="{Binding SelectedProvider.UseTencentSign}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="累计 Token：" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding SelectedProvider.TotalTokens, StringFormat=N0}" />
                                    </StackPanel>
                                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="累计花费：" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding SelectedProvider.TotalConsume, StringFormat=F4}" />
                                    </StackPanel>
                                </WrapPanel>

                                <!--  Model grid  -->
                                <Expander
                                    Grid.Row="2"
                                    Margin="0,6,0,0"
                                    Header="模型配置"
                                    IsExpanded="True">
                                    <StackPanel Margin="0,10,0,0">
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button
                                                Margin="0,0,8,0"
                                                Command="{Binding AddModelCommand}"
                                                Content="新增模型"
                                                Style="{StaticResource ButtonPrimary}" />
                                            <Button
                                                Command="{Binding RemoveModelCommand}"
                                                CommandParameter="{Binding SelectedModel}"
                                                Content="删除选中模型" />
                                        </WrapPanel>
                                        <DataGrid
                                            Height="180"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            ItemsSource="{Binding SelectedProvider.Models}"
                                            SelectedItem="{Binding SelectedModel}">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn
                                                    Width="55"
                                                    Binding="{Binding Enabled}"
                                                    Header="启用" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="模型名" />
                                                <DataGridTemplateColumn Width="90" Header="输入/1M">
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding InputPricePer1M, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F4, ValidatesOnExceptions=True}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding InputPricePer1M, StringFormat=F4}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="110" Header="缓存输入/1M">
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding CachePricePer1M, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F4, ValidatesOnExceptions=True}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding CachePricePer1M, StringFormat=F4}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="90" Header="输出/1M">
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding OutputPricePer1M, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F4, ValidatesOnExceptions=True}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding OutputPricePer1M, StringFormat=F4}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Expander>

                                <!--  Spend summary  -->
                                <Expander
                                    Grid.Row="3"
                                    Margin="0,6,0,0"
                                    Header="模型花费统计"
                                    IsExpanded="True">
                                    <DataGrid
                                        Height="180"
                                        Margin="0,10,0,0"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding SelectedProviderSpend}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding ModelName}"
                                                Header="模型" />
                                            <DataGridTextColumn
                                                Width="60"
                                                Binding="{Binding CallCount}"
                                                Header="调用" />
                                            <DataGridTextColumn
                                                Width="70"
                                                Binding="{Binding PromptTokens}"
                                                Header="输入" />
                                            <DataGridTextColumn
                                                Width="70"
                                                Binding="{Binding CachedPromptTokens}"
                                                Header="缓存" />
                                            <DataGridTextColumn
                                                Width="70"
                                                Binding="{Binding CompletionTokens}"
                                                Header="输出" />
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding TotalTokens}"
                                                Header="总Token" />
                                            <DataGridTextColumn
                                                Width="80"
                                                Binding="{Binding ConsumeText}"
                                                Header="花费" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>

                <!--  Purpose bindings  -->
                <Expander
                    Grid.Row="2"
                    Header="用途与模型绑定"
                    IsExpanded="False">
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PurposeGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PurposeBindingGroup}">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14,12"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <!--  Header  -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Opacity="0.68"
                                                    Text="{Binding Description}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Command="{Binding DataContext.AddPurposeBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="+ 绑定"
                                                Style="{StaticResource ButtonPrimary}" />
                                        </Grid>

                                        <!--  Column labels  -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="12"
                                                Opacity="0.6"
                                                Text="服务商" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="12"
                                                Opacity="0.6"
                                                Text="模型" />
                                        </Grid>

                                        <!--  Binding rows  -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PurposeBindingItem}">
                                                    <Border
                                                        Margin="0,0,0,6"
                                                        Padding="8,6"
                                                        Background="{DynamicResource RegionBrush}"
                                                        CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox
                                                                Grid.Column="0"
                                                                DisplayMemberPath="DisplayName"
                                                                ItemsSource="{Binding DataContext.Providers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                SelectedItem="{Binding SelectedProvider, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ComboBox
                                                                Grid.Column="2"
                                                                DisplayMemberPath="Name"
                                                                ItemsSource="{Binding AvailableModels}"
                                                                SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button
                                                                Grid.Column="3"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.RemovePurposeBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="删除" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  Empty hint  -->
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="13"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Opacity="0.55"
                                            Text="暂无绑定 — 点击「+ 绑定」添加">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="16,10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Button
                MinWidth="120"
                Command="{Binding SaveAllCommand}"
                Content="保存全部"
                Style="{StaticResource ButtonPrimary}" />
        </Border>
    </Grid>
</UserControl>