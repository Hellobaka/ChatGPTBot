<hc:Window
    x:Class="ChatGPTv3.UI.Views.KeyEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="{Binding WindowTitle}"
    Width="980"
    Height="620"
    BorderBrush="{DynamicResource BorderBrush}"
    Style="{StaticResource WindowWin10}"
    WindowStartupLocation="CenterOwner">

    <Border
        Background="{DynamicResource PopupBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  Content  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--  Provider fields  -->
                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Width="300" Margin="0,0,12,10">
                            <TextBlock FontWeight="SemiBold" Text="名称" />
                            <TextBox Margin="0,6,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="300" Margin="0,0,12,10">
                            <TextBlock FontWeight="SemiBold" Text="EndPoint" />
                            <TextBox Margin="0,6,0,0" Text="{Binding EndPoint, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="300" Margin="0,0,12,10">
                            <TextBlock FontWeight="SemiBold" Text="API Key" />
                            <TextBox Margin="0,6,0,0" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="300" Margin="0,0,12,10">
                            <TextBlock FontWeight="SemiBold" Text="接口格式" />
                            <ComboBox
                                Margin="0,6,0,0"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding ApiFormatOptions}"
                                SelectedItem="{Binding SelectedApiFormat}" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <CheckBox
                            Margin="0,0,20,0"
                            Content="启用 Web Search（Anthropic / Responses）"
                            IsChecked="{Binding EnableWebSearch}" />
                        <CheckBox
                            Content="腾讯云签名"
                            IsChecked="{Binding UseTencentSign}" />
                    </WrapPanel>

                    <!--  Model grid  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="模型配置" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding AddModelCommand}"
                            Content="新增模型"
                            Style="{StaticResource ButtonPrimary}" />
                        <Button
                            Command="{Binding RemoveModelCommand}"
                            CommandParameter="{Binding SelectedModel}"
                            Content="删除选中" />
                    </WrapPanel>
                    <DataGrid
                        Height="200"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Models}"
                        SelectedItem="{Binding SelectedModel}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn
                                Width="55"
                                Binding="{Binding Enabled}"
                                Header="启用" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="模型名" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding InputPricePer1M, StringFormat=F4}"
                                Header="输入/M" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CachePricePer1M, StringFormat=F4}"
                                Header="缓存/M" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding OutputPricePer1M, StringFormat=F4}"
                                Header="输出/M" />
                            <DataGridTemplateColumn Width="110" Header="能力">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Capabilities, Converter={x:Static conv:ChatConverters.CapabilityToText}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Padding="6,2"
                                            Command="{Binding DataContext.EditModelCommand, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                            CommandParameter="{Binding}"
                                            Content="编辑"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60" Header="测试">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Padding="6,2"
                                            Command="{Binding DataContext.TestModelCommand, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                            CommandParameter="{Binding}"
                                            Content="测试"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!--  Bottom buttons  -->
            <WrapPanel
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right">
                <Button
                    MinWidth="100"
                    Margin="0,0,12,0"
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    MinWidth="100"
                    Command="{Binding CancelCommand}"
                    Content="取消" />
            </WrapPanel>
        </Grid>
    </Border>
</hc:Window>
