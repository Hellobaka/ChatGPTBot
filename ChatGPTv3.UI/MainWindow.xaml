<hc:Window
    x:Class="ChatGPTv3.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ChatGPTv3.UI.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:models="clr-namespace:ChatGPTv3.UI.Models"
    Title="ChatGPTv3 管理面板"
    Width="1200"
    Height="750"
    MinWidth="900"
    MinHeight="600"
    BorderBrush="{DynamicResource BorderBrush}"
    Style="{StaticResource WindowWin10}"
    WindowStartupLocation="CenterScreen">

    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </hc:Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ── Left sidebar ──  -->
        <Border
            x:Name="Sidebar"
            Grid.Column="0"
            Width="220">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Grid
                    x:Name="HeaderRow"
                    Grid.Row="0"
                    MinHeight="56">

                    <!--  Expanded layout  -->
                    <StackPanel
                        x:Name="HeaderExpanded"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <iconPacks:PackIconMaterialDesign
                            x:Name="HeaderIcon"
                            Width="22"
                            Height="22"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="#89B4FA"
                            Kind="Android" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="ChatGPTv3" />
                    </StackPanel>

                    <!--  Collapsed toggle button  -->
                    <Button
                        x:Name="ToggleBtn"
                        Width="40"
                        Height="40"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ToggleSidebar">
                        <iconPacks:PackIconMaterialDesign
                            x:Name="ToggleIcon"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#B0B0B0"
                            Kind="ChevronLeft" />
                    </Button>
                </Grid>

                <!--  Nav items  -->
                <ListBox
                    x:Name="NavList"
                    Grid.Row="1"
                    Padding="0"
                    BorderThickness="0"
                    SelectionChanged="OnNavSelectionChanged"
                    SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavigationItem}">
                            <StackPanel
                                MinHeight="24"
                                Margin="14,12"
                                Cursor="Hand"
                                Orientation="Horizontal">
                                <iconPacks:PackIconMaterialDesign
                                    Width="20"
                                    Height="20"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Foreground="#B0B0B0"
                                    Kind="{Binding IconKind}" />
                                <TextBlock
                                    x:Name="ItemLabel"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}"
                                    Visibility="{Binding SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--  ── Right content area ──  -->
        <Border Grid.Column="1">
            <ContentControl
                x:Name="ContentArea"
                Margin="16"
                VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</hc:Window>