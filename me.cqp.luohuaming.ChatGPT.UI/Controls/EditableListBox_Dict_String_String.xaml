<UserControl
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Controls.EditableListBox_Dict_String_String"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    d:DataContext="{d:DesignInstance Type=local:EditableListBox_Dict_String_String}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ListBox
            x:Name="EditableListBox"
            MinHeight="70"
            Margin="0,5,0,0"
            ItemsSource="{Binding ItemDisplaySource, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock FontWeight="Bold" Text="{Binding Key}" />
                        <TextBlock FontWeight="Bold" Text="=&gt;" />
                        <TextBlock Text="{Binding Value}" />
                    </ui:SimpleStackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="EditableListBoxRemoveButton"
                Grid.Column="0"
                Width="50"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Click="EditableListBoxRemoveButton_Click">
                删除
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="键：" />
            <TextBox
                x:Name="EditableListBoxKey"
                Grid.Column="2"
                VerticalAlignment="Center"
                PreviewKeyDown="EditableListBoxAdd_PreviewKeyDown"
                Text="{Binding AddItemKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock
                Grid.Column="3"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="值：" />
            <TextBox
                x:Name="EditableListBoxValue"
                Grid.Column="4"
                PreviewKeyDown="EditableListBoxAdd_PreviewKeyDown"
                Text="{Binding AddItemValueInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Button
                x:Name="EditableListBoxAddButton"
                Grid.Column="5"
                Width="50"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Click="EditableListBoxAddButton_Click">
                添加
            </Button>
        </Grid>
    </Grid>
</UserControl>
