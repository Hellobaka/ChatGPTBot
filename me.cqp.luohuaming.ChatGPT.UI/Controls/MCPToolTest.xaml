<UserControl
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Controls.MCPToolTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodel="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MCPToolTestViewModel}"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:BoolToVisibilityRevertConverter x:Key="BoolToVisibilityRevertConverter" />
        <converter:BoolRevertConverter x:Key="BoolRevertConverter" />
        <converter:InsertImageTaskListMultiConverter x:Key="InsertImageTaskListMultiConverter" />
        <converter:InsertImageResultConverter x:Key="InsertImageResultConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ui:SimpleStackPanel
            Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            Spacing="5">
            <TextBlock Text="{Binding ToolName, StringFormat=当前工具：{0}}" />
            <TextBlock Text="{Binding ToolDescription, StringFormat=描述：{0}}" />
        </ui:SimpleStackPanel>
        <GridSplitter
            Grid.Row="1"
            Width="3"
            HorizontalAlignment="Right"
            VerticalContentAlignment="Stretch"
            Panel.ZIndex="99"
            Cursor="SizeWE"
            ResizeDirection="Columns" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,5"
                FontSize="20"
                Text="参数列表" />
            <ItemsControl
                Grid.Row="1"
                Margin="0,0,5,0"
                ItemsSource="{Binding Arguments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:SimpleStackPanel Margin="0,0,0,10" Spacing="5">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding ArgumentName}" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="Red"
                                    Text="*"
                                    Visibility="{Binding Required, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding ArgumentType}" />
                            </ui:SimpleStackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Description}" />
                            <TextBox ui:ControlHelper.PlaceholderText="{Binding DefaultValue}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </ui:SimpleStackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="5,5,0,5"
                FontSize="20"
                Text="请求预览" />
            <TextBox
                Grid.Row="1"
                Margin="5,0,0,0"
                IsReadOnly="True"
                Text="{Binding ParsedRequest}" />
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <GridSplitter
                Height="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Panel.ZIndex="99"
                Cursor="SizeNS" />
            <TextBlock
                Grid.Row="0"
                Margin="0,5"
                FontSize="20"
                Text="请求结果" />
            <TextBox
                Grid.Row="1"
                Margin="0,5"
                IsReadOnly="True"
                Text="{Binding Response}" />
        </Grid>

        <Button
            x:Name="SendRequestButton"
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Margin="5"
            HorizontalAlignment="Stretch"
            Click="SendRequestButton_Click"
            Style="{StaticResource AccentButtonStyle}">
            请求
        </Button>
    </Grid>
</UserControl>
