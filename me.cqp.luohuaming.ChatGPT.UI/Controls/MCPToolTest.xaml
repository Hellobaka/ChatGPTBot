<UserControl
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Controls.MCPToolTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodel="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.ViewModel"
    d:DataContext="{d:DesignInstance Type=viewmodel:MCPToolTestViewModel}"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:BoolToVisibilityRevertConverter x:Key="BoolToVisibilityRevertConverter" />
        <converter:BoolRevertConverter x:Key="BoolRevertConverter" />
        <converter:InsertImageTaskListMultiConverter x:Key="InsertImageTaskListMultiConverter" />
        <Style
            x:Key="SelectableTextBlock"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Style.Resources>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
            </Style.Resources>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBox Style="{StaticResource SelectableTextBlock}" Text="{Binding ToolName, StringFormat=当前工具：{0}}" />
            <TextBox Style="{StaticResource SelectableTextBlock}" Text="{Binding ToolDescription, StringFormat=描述：{0}}" />
        </StackPanel>
        <GridSplitter
            Grid.Row="1"
            Width="3"
            HorizontalAlignment="Right"
            VerticalContentAlignment="Stretch"
            Panel.ZIndex="99"
            Cursor="SizeWE"
            ResizeDirection="Columns" />
        <Grid Grid.Row="1" IsEnabled="{Binding Requesting, Converter={StaticResource BoolRevertConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,5"
                FontSize="20"
                Text="参数列表" />
            <ItemsControl
                Grid.Row="1"
                Margin="0,0,5,0"
                ItemsSource="{Binding Arguments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:SimpleStackPanel Margin="0,0,0,10" Spacing="5">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding ArgumentName}" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="Red"
                                    Text="*"
                                    Visibility="{Binding Required, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding ArgumentType}" />
                            </ui:SimpleStackPanel>
                            <TextBox Style="{StaticResource SelectableTextBlock}" Text="{Binding Description}" />
                            <TextBox ui:ControlHelper.PlaceholderText="{Binding DefaultValue}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </ui:SimpleStackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="5,5,0,5"
                FontSize="20"
                Text="请求预览" />
            <TextBox
                Grid.Row="1"
                Margin="5,0,0,0"
                IsReadOnly="True"
                Text="{Binding ParsedRequest}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,5"
                FontSize="20"
                Text="请求结果" />
            <TextBox
                Grid.Row="1"
                Margin="0,5"
                IsReadOnly="True"
                Text="{Binding Response}"
                TextWrapping="Wrap" />
        </Grid>

        <Button
            x:Name="SendRequestButton"
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Margin="0,5"
            HorizontalAlignment="Stretch"
            Click="SendRequestButton_Click"
            IsEnabled="{Binding Requesting, Converter={StaticResource BoolRevertConverter}}"
            Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsActive="True" Visibility="{Binding Requesting, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:ProgressRing.Foreground>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                    </ui:ProgressRing.Foreground>
                </ui:ProgressRing>
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Text="请求" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
