<ui:ContentDialog
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Pages.KeyEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:db="clr-namespace:me.cqp.luohuaming.ChatGPT.PublicInfos.DB;assembly=me.cqp.luohuaming.ChatGPT.PublicInfos"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    d:DataContext="{d:DesignInstance Type=local:KeyEdit}"
    d:DesignHeight="900"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ui:ContentDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Width="80" VerticalAlignment="Center">备注：</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding ApiKey.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Width="80" VerticalAlignment="Center">EndPoint：</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding ApiKey.EndPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Width="80" VerticalAlignment="Center">Key：</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding ApiKey.APIKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Width="80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    腾讯云签名：
                </TextBlock>
                <CheckBox Grid.Column="1" IsChecked="{Binding ApiKey.UseTencentSign, Mode=TwoWay}" />
            </Grid>
            <Grid Margin="0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Width="80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    可用模型：
                </TextBlock>
                <ListBox
                    x:Name="LLMModelList"
                    Grid.Row="1"
                    MinHeight="100"
                    Margin="0,5"
                    ItemsSource="{Binding AvailableModels}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" Margin="0,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        Click="AddModel_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        添加一项
                    </Button>
                    <Button
                        Grid.Column="1"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Stretch"
                        Click="EditModel_Click">
                        编辑选中
                    </Button>
                    <Button
                        Grid.Column="2"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        Click="DeleteModel_Click">
                        删除选中
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
        <TextBlock
            Name="TestResultDisplay"
            Grid.Row="1"
            Visibility="Collapsed" />
        <Grid Grid.Row="2">
            <Button
                Name="TestButton"
                Margin="0,5"
                HorizontalAlignment="Stretch"
                Click="TestButton_Click"
                ToolTip="调用此Key的第一个模型并发送一次聊天请求。Embedding与Rerank模型请不要防止在第一位">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing
                        Name="TestingStatus"
                        Margin="0,0,5,0"
                        IsActive="True"
                        Visibility="Collapsed" />
                    <TextBlock>测试 Key</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Margin="0,0,5,0"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                保存
            </Button>
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click">
                取消
            </Button>
        </Grid>
    </Grid>
</ui:ContentDialog>
