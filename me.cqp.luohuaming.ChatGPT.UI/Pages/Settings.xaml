<Page
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Pages.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    d:Height="1500"
    d:Width="1200"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="API设置">
                <ScrollViewer>
                    <StackPanel x:Name="APIContainer" Margin="16,16,22,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">流式输出:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="StreamMode"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">启用 MCP:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableMCP"
                                Width="45"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                            <TextBlock VerticalAlignment="Center">部分服务商在开启MCP后无法使用思考模型；修改配置后请重载插件</TextBlock>
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">最大Token:</TextBlock>
                        <TextBox x:Name="ChatMaxTokens" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">Temperature:</TextBlock>
                        <TextBox x:Name="ChatTemperature" Margin="0,5,0,0" />
                        <TextBlock
                            Margin="0,10,0,5"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}">
                            分功能 Key 池
                        </TextBlock>

                        <TabControl
                            x:Name="KeyPurposeTabControl"
                            Margin="0,10,0,0"
                            SelectionChanged="KeyPurposeTabControl_SelectionChanged">
                            <TabItem Header="聊天/日程" Tag="Chat" />
                            <TabItem Header="分段" Tag="Splitter" />
                            <TabItem Header="图片描述" Tag="ImageDescriber" />
                            <TabItem Header="Embedding" Tag="Embedding" />
                            <TabItem Header="Rerank" Tag="Rerank" />
                        </TabControl>
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">接口调用超时（ms）:</TextBlock>
                        <TextBox x:Name="ChatTimeout" Margin="0,5,0,0" />
                        <TextBox
                            x:Name="EmbeddingTimeout"
                            Margin="0,5,0,0"
                            Visibility="Collapsed" />
                        <TextBox
                            x:Name="RerankTimeout"
                            Margin="0,5,0,0"
                            Visibility="Collapsed" />
                        <TextBox
                            x:Name="SplitterTimeout"
                            Margin="0,5,0,0"
                            Visibility="Collapsed" />
                        <TextBox
                            x:Name="ImageDescriberTimeout"
                            Margin="0,5,0,0"
                            Visibility="Collapsed" />
                        <TextBlock
                            Margin="0,10,0,5"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}">
                            Key 管理
                        </TextBlock>
                        <Button
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            Click="CreateKeyButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            新增
                        </Button>
                        <Button
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            Click="ReloadButton_Click">
                            刷新
                        </Button>
                        <DataGrid
                            x:Name="KeyPurposeDataGrid"
                            Grid.Row="2"
                            VerticalAlignment="Stretch"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            EnableRowVirtualization="True"
                            HorizontalScrollBarVisibility="Auto"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Key.Name}"
                                    Header="Key名称" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding ModelName}"
                                    Header="模型名称" />
                                <DataGridTemplateColumn Width="200" Header="操作">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button
                                                    Margin="5,0,0,0"
                                                    Click="KeyPurposeEditButton_Click"
                                                    Style="{StaticResource AccentButtonStyle}">
                                                    编辑
                                                </Button>
                                                <Button
                                                    Margin="5,0,0,0"
                                                    Click="KeyPurposeDeleteButton_Click"
                                                    Style="{StaticResource ErrorButtonStyle}">
                                                    删除
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="群组设置">
                <ScrollViewer>
                    <StackPanel x:Name="GroupContainer" Margin="16,16,22,16">
                        <TextBlock VerticalAlignment="Center">主人 QQ:</TextBlock>
                        <controls:EditableListBox_Int
                            x:Name="MasterQQ"
                            MinHeight="20"
                            Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">群组使用黑名单:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="IsGroupBlackList"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" VerticalAlignment="Center">群组列表:</TextBlock>
                        <controls:EditableListBox_Int
                            x:Name="GroupList"
                            MinHeight="20"
                            Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">私聊使用黑名单:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="IsPersonBlackList"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" VerticalAlignment="Center">私聊列表:</TextBlock>
                        <controls:EditableListBox_Int
                            x:Name="PersonList"
                            MinHeight="20"
                            Margin="0,5,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="对话设置">
                <ScrollViewer>
                    <StackPanel x:Name="ChatContainer" Margin="16,16,22,16">
                        <TextBlock VerticalAlignment="Center">Bot 首选名称:</TextBlock>
                        <TextBox x:Name="BotName" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">Bot 名称列表:</TextBlock>
                        <controls:EditableListBox_String
                            x:Name="BotNicknames"
                            MinHeight="20"
                            Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">过滤词列表:</TextBlock>
                        <controls:EditableListBox_String
                            x:Name="Filters"
                            MinHeight="20"
                            Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">每次对话携带的上下文数量:</TextBlock>
                        <TextBox x:Name="ContextMaxLength" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">不发送消息时的回应:</TextBlock>
                        <TextBox x:Name="ChatEmptyResponse" Margin="0,5,0,0" />

                        <TextBlock Margin="0,10,0,0">私聊使用的人格:</TextBlock>
                        <TextBox
                            x:Name="PrivatePrompt"
                            Margin="0,5,0,0"
                            AcceptsReturn="True"
                            TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">群组使用的人格:</TextBlock>
                        <TextBox
                            x:Name="GroupPrompt"
                            Margin="0,5,0,0"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">输出调试日志:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="DebugMode"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="响应设置">
                <ScrollViewer>
                    <StackPanel x:Name="ResponseContainer" Margin="16,16,22,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">触发消息为未记录消息时跳过回复:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="RecordNotExistSkipResponse"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">回复意愿倍率:</TextBlock>
                        <TextBox x:Name="ReplyWillingAmplifier" Margin="0,5,0,0" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">使用回复模式发送消息:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableGroupReply"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">是否启用分段功能:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableSplitter"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">移除思维链输出:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="RemoveThinkBlock"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>

                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">最大分段数量:</TextBlock>
                        <TextBox x:Name="SplitterMaxLines" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">使用分段的最小文本长度:</TextBlock>
                        <TextBox x:Name="SplitterMinLength" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">移除分段末尾标点符号:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="SplitterRegexRemovePunctuation"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">分段仅使用正则表达式（按标点符号分句）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="SplitterRegexFirst"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">发送每个分段启用随机延时:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableSplitterRandomDelay"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">分段模拟打字速度（字符/分钟）:</TextBlock>
                        <TextBox x:Name="SplitterSimulateTypeSpeed" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">分段随机等待延时随机数下限（毫秒）:</TextBlock>
                        <TextBox x:Name="SplitterRandomDelayMin" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">分段随机等待延时随机数上限（毫秒）:</TextBlock>
                        <TextBox x:Name="SplitterRandomDelayMax" Margin="0,5,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="表情包设置">
                <ScrollViewer>
                    <StackPanel x:Name="EmojiContainer" Margin="16,16,22,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">启用图片刮削（不开启所有图片都不处理）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableVision"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">允许被动发送表情包（概率驱动）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableEmojiPassiveSend"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">发送表情的概率 (%):</TextBlock>
                        <TextBox
                            x:Name="EmojiSendProbability"
                            Margin="0,5,0,0"
                            IsEnabled="{Binding IsOn, ElementName=EnableEmojiPassiveSend}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">允许主动发送表情包（消息模板）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableEmojiActiveSend"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">是否从推荐中随机发送表情（否则只发送得分最高的图片）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="RandomSendEmoji"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">推荐的表情数量:</TextBlock>
                        <TextBox x:Name="RecommendEmojiCount" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">只处理表情包图片（不处理非表情包图片）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="IgnoreNotEmoji"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">非表情包图片缓存天数:</TextBlock>
                        <TextBox
                            x:Name="NonEmojiPictureSaveDays"
                            Margin="0,5,0,0"
                            IsEnabled="{Binding IsOn, ElementName=IgnoreNotEmoji, Converter={StaticResource BoolRevertConverter}}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">引用图片并提及时临时启用视觉（不受图片刮削配置控制、不限制图片类型）:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableVisionWhenMentioned"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="日程设置">
                <ScrollViewer>
                    <StackPanel x:Name="ScheduleContainer" Margin="16,16,22,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">是否启用日程:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableEnableSchedules"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">获取日程的人格文本:</TextBlock>
                        <TextBox
                            x:Name="SchedulePrompt"
                            Margin="0,5,0,0"
                            AcceptsReturn="True"
                            TextWrapping="Wrap" />
                        <TextBlock VerticalAlignment="Center">没有对应时间点的日程安排的默认值:</TextBlock>
                        <TextBox x:Name="DefaultSchedule" Margin="0,5,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="记忆设置">
                <ScrollViewer>
                    <StackPanel x:Name="MemoryContainer" Margin="16,16,22,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">是否启用记忆功能:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="EnableMemory"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center">Embedding的维度:</TextBlock>
                        <TextBox x:Name="MemoryDimensions" Margin="0,5,0,0" />
                        <TextBlock VerticalAlignment="Center">召回最小记忆相似度:</TextBlock>
                        <TextBox x:Name="MinMemorySimilarity" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">召回最大记忆数量:</TextBlock>
                        <TextBox x:Name="MaxMemoryCount" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">Qdrant 服务IP:</TextBlock>
                        <TextBox x:Name="QdrantHost" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">Qdrant 服务端口:</TextBlock>
                        <TextBox x:Name="QdrantPort" Margin="0,5,0,0" />
                        <TextBlock Margin="0,5,0,0" VerticalAlignment="Center">Qdrant 的API密钥:</TextBlock>
                        <TextBox x:Name="QdrantAPIKey" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center">Qdrant 是否只搜索个人记忆:</TextBlock>
                            <ui:ToggleSwitch
                                x:Name="QdrantSearchOnlyPerson"
                                Margin="10,0,0,0"
                                OffContent=""
                                OnContent="" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Button
            x:Name="SaveButton"
            Grid.Row="1"
            Margin="16,5,16,16"
            HorizontalAlignment="Stretch"
            Click="SaveButton_Click"
            Style="{StaticResource AccentButtonStyle}">
            保存
        </Button>
    </Grid>
</Page>
