<Page
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Pages.MCP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:converter="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodel="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.ViewModel"
    Title="MCP"
    d:DataContext="{d:DesignInstance Type=viewmodel:MCPViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:BoolToVisibilityRevertConverter x:Key="BoolToVisibilityRevertConverter" />
        <converter:BoolRevertConverter x:Key="BoolRevertConverter" />
        <converter:InsertImageTaskListMultiConverter x:Key="InsertImageTaskListMultiConverter" />
        <converter:InsertImageResultConverter x:Key="InsertImageResultConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <GridSplitter
            Margin="2,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Panel.ZIndex="99"
            BorderBrush="LightGray"
            BorderThickness="1"
            Cursor="SizeWE" />
        <Grid Background="{StaticResource SystemControlForegroundChromeMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="MCP服务器编辑" />
                <Button
                    x:Name="RebuildMCPButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Click="RebuildMCPButton_Click"
                    Foreground="{StaticResource SystemControlBackgroundAccentBrush}"
                    IsEnabled="{Binding Rebuilding, Converter={StaticResource BoolRevertConverter}}"
                    ToolTip="重建">
                    <ui:FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="AddMCPButton"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="AddMCPButton_Click"
                    Content="新增一项"
                    IsEnabled="{Binding Rebuilding, Converter={StaticResource BoolRevertConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <ProgressBar
                Grid.Row="1"
                IsIndeterminate="True"
                Visibility="{Binding Rebuilding, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ScrollViewer
                Grid.Row="2"
                Margin="10,0,10,10"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TreeView
                    x:Name="MCPClientContainer"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding Rebuilding, Converter={StaticResource BoolRevertConverter}}"
                    ItemsSource="{Binding MCPClients}"
                    SelectedItemChanged="MCPClientContainer_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultTreeViewItemStyle}" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Tools}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,20,0">
                    <controls:MCPClientEdit
                        x:Name="MCPClientEditControl"
                        MCPClientModel="{Binding SelectedMCPItem}"
                        Visibility="Collapsed" />
                    <controls:MCPToolTest
                        x:Name="MCPToolTestControl"
                        MCPToolModel="{Binding SelectedMCPItem}"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                x:Name="ActionContainer"
                Grid.Row="1"
                Margin="00,0,20,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <Button
                    x:Name="DeleteButton"
                    Width="70"
                    Click="DeleteButton_Click"
                    Content="删除"
                    Style="{StaticResource ErrorButtonStyle}" />
                <Button
                    x:Name="CancelButton"
                    Width="70"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click"
                    Content="取消" />
                <Button
                    x:Name="SaveButton"
                    Width="70"
                    Margin="10,0,0,0"
                    Click="SaveButton_Click"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
