<Page
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Pages.MCP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Controls"
    xmlns:converter="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:viewmodel="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.ViewModel"
    Title="MCP"
    d:DataContext="{d:DesignInstance Type=viewmodel:MCPViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:BoolToVisibilityRevertConverter x:Key="BoolToVisibilityRevertConverter" />
        <converter:BoolRevertConverter x:Key="BoolRevertConverter" />
        <converter:InsertImageTaskListMultiConverter x:Key="InsertImageTaskListMultiConverter" />
        <converter:InsertImageResultConverter x:Key="InsertImageResultConverter" />
        <DataTemplate x:Key="MCPClientEditTemplate">
            <controls:MCPClientEdit />
        </DataTemplate>
        <DataTemplate x:Key="MCPToolTestTemplate">
            <controls:MCPToolTest />
        </DataTemplate>

        <converter:MCPEditSelector
            x:Key="MCPEditSelector"
            MCPClientEditTemplate="{StaticResource MCPClientEditTemplate}"
            MCPToolTestTemplate="{StaticResource MCPToolTestTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>
        <GridSplitter
            Grid.Column="1"
            Margin="2,0"
            BorderBrush="LightGray"
            BorderThickness="1"
            Cursor="SizeWE" />
        <Grid Background="{StaticResource SystemControlForegroundChromeMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="MCP服务器编辑" />
                <Button
                    x:Name="RebuildMCPButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Click="RebuildMCPButton_Click"
                    Foreground="{StaticResource SystemControlBackgroundAccentBrush}"
                    IsEnabled="{Binding Rebuilding, Converter={StaticResource BoolRevertConverter}}"
                    ToolTip="重建">
                    <ui:FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="AddMCPButton"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="AddMCPButton_Click"
                    Content="新增一项"
                    IsEnabled="{Binding Rebuilding, Converter={StaticResource BoolRevertConverter}}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <ProgressBar
                Grid.Row="1"
                IsIndeterminate="True"
                Visibility="{Binding Rebuilding, Converter={StaticResource BoolToVisibilityConverter}}" />
            <ScrollViewer
                Grid.Row="2"
                Margin="10,0,10,10"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TreeView
                    x:Name="MCPClientContainer"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsEnabled="{Binding Rebuilding, Converter={StaticResource BoolRevertConverter}}"
                    ItemsSource="{Binding MCPClients}"
                    SelectedItemChanged="MCPClientContainer_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultTreeViewItemStyle}" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Tools}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ItemsControl ItemTemplateSelector="{StaticResource MCPEditSelector}" ItemsSource="{Binding SelectedMCPItem}" />
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button Width="70" Content="取消" />
                <Button
                    Width="70"
                    Margin="10,0,0,0"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
