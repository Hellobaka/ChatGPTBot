<Page
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Pages.Misc"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="Misc"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TabControl SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="心情" Tag="Mood" />
            <TabItem Header="日程" Tag="Schedule" />
            <TabItem Header="关系" Tag="Relationship" />
        </TabControl>
        <ui:Frame
            x:Name="MiscFrame"
            Grid.Row="1"
            Style="{DynamicResource CascadeDataContextFrame}" />
    </Grid>
</Page>
