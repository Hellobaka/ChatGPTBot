<Window
    x:Class="me.cqp.luohuaming.ChatGPT.UI.Windows.LLMModelEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:db="clr-namespace:me.cqp.luohuaming.ChatGPT.PublicInfos.DB;assembly=me.cqp.luohuaming.ChatGPT.PublicInfos"
    xmlns:local="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:me.cqp.luohuaming.ChatGPT.UI.Pages"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="编辑一个模型"
    Width="430"
    d:DataContext="{d:DesignInstance Type=db:LLMModel}"
    ui:WindowHelper.UseModernWindowStyle="True"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ui:SimpleStackPanel
            Margin="5"
            Orientation="Vertical"
            Spacing="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">模型名称:</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">输入开销 (每 1M) :</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding InputConsumePer1M, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">缓存输入开销 (每 1M) :</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding InputCachedConsumePer1M, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">输出开销 (每 1M) :</TextBlock>
                <TextBox Grid.Column="1" Text="{Binding OutputConsumePer1M, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
        </ui:SimpleStackPanel>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Margin="0,0,5,0"
                HorizontalAlignment="Stretch"
                Click="CloseButton_Click">
                关闭
            </Button>
            <Button
                Grid.Column="1"
                Margin="5,0,0,0"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Style="{StaticResource AccentButtonStyle}">
                保存
            </Button>
        </Grid>
    </Grid>
</Window>
